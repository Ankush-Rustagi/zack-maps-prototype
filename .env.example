# Mapbox public token — get one at https://account.mapbox.com/access-tokens/
# Without this, the prototype falls back to the placeholder CSS-grid map.
VITE_MAPBOX_TOKEN=

# Optional: custom Mapbox style URLs (e.g. mapbox://styles/your-org/your-style-id)
# Used as the "Street" basemap, picked per current theme. If unset, falls back
# to Mapbox's stock light/dark.
VITE_MAPBOX_STYLE_LIGHT=
VITE_MAPBOX_STYLE_DARK=
